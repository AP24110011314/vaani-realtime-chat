# Database & Compose
DB_HOST=localhost
DB_PORT=3307
DB_NAME=vanni
DB_USER=vanni
DB_PASSWORD=vannipass
DB_ROOT_PASSWORD=rootpass
APP_PORT=8088

# Backend
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local          # local | cloudinary | s3
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=10
CLOUDINARY_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Frontend (Vite; only VITE_* are exposed to the browser - never put secrets here)
VITE_API_BASE=/api
VITE_WS_PATH=/ws

# Scheduling
SCHEDULE_MIN_LEAD_SECONDS=60

# AI Features (Catch Me Up)
AI_FEATURES_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_MAX_INPUT_CHARS=60000
AI_TIMEOUT_SECONDS=30
AI_RATE_PER_HOUR=10
AI_RATE_PER_DAY=30
